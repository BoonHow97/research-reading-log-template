\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{paperlog}[2026/08/02 Custom Package for Research Paper Reading Logs]

% --- CORE PACKAGES ---
\RequirePackage[utf8]{inputenc}
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{braket} % For Dirac notation (bras and kets)
\RequirePackage{graphicx}
\RequirePackage{geometry}
\geometry{a4paper, margin=1in}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins, breakable}

% --- CLEAN LIST FORMATTING ---
\RequirePackage{enumitem}
\setlist[itemize]{topsep=2pt, itemsep=4pt, leftmargin=1.5em}

% --- NAVIGATION & BIBLIOGRAPHY ---
\RequirePackage[colorlinks=true, linkcolor=blue, citecolor=blue]{hyperref}
% Using style=alphabetic generates [Aar04], [Doe26] style reference labels
\RequirePackage[style=alphabetic]{biblatex}

% --- BRAND COLORS ---
\definecolor{LogPrimary}{RGB}{29, 78, 216}     % Deep Slate Blue
\definecolor{LogBackground}{RGB}{248, 250, 252}% Cool Off-White
\definecolor{LogBorder}{RGB}{203, 213, 225}    % Crisp Slate Gray
\definecolor{LogAccent}{RGB}{239, 68, 68}      % Subtle Red for limitations

% --- 1. PAPER HEADER BOX ---
% Usage: \begin{paperbox}{Title}{Authors}{Venue & Year}{BibTeX Key}
\newtcolorbox{paperbox}[4]{
    enhanced,
    breakable=false,
    colback=LogBackground,
    colframe=LogPrimary,
    coltitle=white,
    fonttitle=\bfseries\Large,
    before={\phantomsection\addcontentsline{toc}{subsection}{#1}\vspace{0.5em}},
    % \hypersetup{citecolor=white} forces the citation link to render bright white on the blue banner
    title={#1 \hfill \normalsize\normalfont\hypersetup{citecolor=white}\textbf{\texttt{\cite{#4}}}},
    boxrule=1.2pt,
    arc=5pt,
    left=14pt, right=14pt, top=10pt, bottom=10pt,
    before upper={
        \noindent\textbf{Authors:} #2 \hfill \textbf{Venue:} #3\par
        \vspace{8pt}
        {\color{LogBorder}\hrule height 0.8pt}
        \vspace{8pt}
        \noindent\textbf{\color{LogPrimary}One-Sentence Takeaway:~}
    }
}

% --- 2. KEY INSIGHT CALLOUT BOX ---
\newtcolorbox{insightbox}[1][Key Insight]{
    enhanced,
    breakable,
    colback=LogPrimary!4!white,
    colframe=LogPrimary,
    boxrule=0pt,
    leftrule=4pt,
    arc=0pt,
    left=12pt, right=12pt, top=8pt, bottom=8pt,
    title={\textbf{#1}},
    coltitle=LogPrimary,
    attach title to upper=\par,
    fonttitle=\bfseries
}

% --- 3. SECTION SHORTCUT COMMANDS ---
\newcommand{\loggap}{\vspace{1.4em}\noindent{\large\textbf{\color{LogPrimary}1. Research Gap \& Motivation}}\par\vspace{0.3em}}
\newcommand{\logmethod}{\vspace{1.4em}\noindent{\large\textbf{\color{LogPrimary}2. Core Method \& Key Insight}}\par\vspace{0.3em}}
\newcommand{\logresults}{\vspace{1.4em}\noindent{\large\textbf{\color{LogPrimary}3. Main Results}}\par\vspace{0.3em}}
\newcommand{\loglimitations}{\vspace{1.4em}\noindent{\large\textbf{\color{LogPrimary}4. Limitations \& Open Questions}}\par\vspace{0.3em}}
\newcommand{\logtakeaways}{\vspace{1.4em}\noindent{\large\textbf{\color{LogPrimary}5. My Takeaways \& Action Items}}\par\vspace{0.3em}}

% --- 4. TAG LABELS (for cross-topic search) ---
\newcommand{\logtags}[1]{%
  \vspace{0.6em}\noindent
  \small\textbf{\color{LogPrimary}Tags:}~\texttt{#1}%
  \par\vspace{0.2em}
}

\endinput